<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ToDoApp.ViewModels"
             xmlns:models="clr-namespace:ToDoApp.Models"
             x:Class="ToDoApp.MainPage"
             x:Name="GardenPage"
             x:DataType="vm:MainViewModel"
             Title="bahçem"
             BackgroundColor="{StaticResource Cream}"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">

    <Grid>
        <CollectionView ItemsSource="{Binding Tasks}"
                        RemainingItemsThreshold="0"
                        SelectionMode="None"
                        BackgroundColor="Transparent">
            <CollectionView.Header>
                <VerticalStackLayout Padding="24,28,24,8" Spacing="14">
                    <Image Source="vine_top.png"
                           HeightRequest="42"
                           Aspect="AspectFit"
                           HorizontalOptions="Center"
                           Opacity="0.9" />

                    <Label Text="bahçem"
                           FontFamily="Playfair"
                           FontSize="40"
                           TextColor="{StaticResource Ink}"
                           HorizontalTextAlignment="Center" />

                    <Label Text="{Binding Greeting}"
                           FontFamily="Caveat"
                           FontSize="24"
                           TextColor="{StaticResource SageDeep}"
                           HorizontalTextAlignment="Center" />

                    <Label Text="{Binding TodayLabel}"
                           FontFamily="Nunito"
                           FontSize="13"
                           TextColor="{StaticResource InkSoft}"
                           HorizontalTextAlignment="Center" />

                    <Border StrokeThickness="0"
                            BackgroundColor="{StaticResource Blush}"
                            Padding="16,14"
                            StrokeShape="RoundRectangle 22">
                        <Border.Shadow>
                            <Shadow Brush="{StaticResource DustyRoseBrush}"
                                    Offset="0,8"
                                    Radius="18"
                                    Opacity="0.16" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="8">
                            <HorizontalStackLayout Spacing="8">
                                <Image Source="daisy.png" WidthRequest="22" HeightRequest="22" />
                                <Label Text="{Binding ProgressLabel}"
                                       FontFamily="Nunito"
                                       FontSize="14"
                                       TextColor="{StaticResource Ink}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <ProgressBar Progress="{Binding Progress}"
                                         ProgressColor="{StaticResource Sage}"
                                         HeightRequest="8" />
                        </VerticalStackLayout>
                    </Border>

                    <Border StrokeThickness="0"
                            BackgroundColor="{StaticResource Card}"
                            Padding="6,6,6,6"
                            StrokeShape="RoundRectangle 24">
                        <Border.Shadow>
                            <Shadow Brush="{StaticResource InkBrush}"
                                    Offset="0,6"
                                    Radius="16"
                                    Opacity="0.08" />
                        </Border.Shadow>
                        <Grid ColumnDefinitions="*,auto" ColumnSpacing="8" Padding="10,4">
                            <Entry Placeholder="ne ekelim bugün?"
                                   Text="{Binding NewTask}"
                                   FontFamily="Nunito"
                                   FontSize="15"
                                   TextColor="{StaticResource Ink}"
                                   PlaceholderColor="{StaticResource InkSoft}"
                                   ReturnType="Done"
                                   Completed="OnNewTaskCompleted" />
                            <Button Grid.Column="1"
                                    Text="ekle 🌷"
                                    Command="{Binding AddTaskCommand}"
                                    FontFamily="Nunito"
                                    FontSize="14"
                                    Padding="16,8"
                                    CornerRadius="18"
                                    BackgroundColor="{StaticResource DustyRose}"
                                    TextColor="White"
                                    HeightRequest="42" />
                        </Grid>
                    </Border>

                    <Label Text="bugünün çiçekleri"
                           FontFamily="Caveat"
                           FontSize="22"
                           TextColor="{StaticResource Ink}"
                           Margin="4,8,0,0" />
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="32,20" Spacing="8" HorizontalOptions="Center">
                    <Image Source="daisy.png" WidthRequest="72" HeightRequest="72" Opacity="0.85" />
                    <Label Text="bahçe henüz uykuda"
                           FontFamily="Playfair"
                           FontSize="20"
                           TextColor="{StaticResource Ink}"
                           HorizontalTextAlignment="Center" />
                    <Label Text="ilk tohumunu ek, izle açılsın 🌱"
                           FontFamily="Nunito"
                           FontSize="14"
                           TextColor="{StaticResource InkSoft}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:TodoItem">
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="sil 🍂"
                                           BackgroundColor="#C97B84"
                                           Command="{Binding Source={x:Reference GardenPage}, Path=BindingContext.DeleteTaskCommand, x:DataType={x:Null}}"
                                           CommandParameter="{Binding .}" />
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <Border Margin="24,0,24,12"
                                Padding="14,12"
                                StrokeThickness="0"
                                BackgroundColor="{Binding CardTint}"
                                StrokeShape="RoundRectangle 20">
                            <Border.Shadow>
                                <Shadow Brush="#C4A494"
                                        Offset="0,5"
                                        Radius="14"
                                        Opacity="0.14" />
                            </Border.Shadow>
                            <Grid ColumnDefinitions="auto,*,auto" ColumnSpacing="12">
                                <Border StrokeShape="RoundRectangle 16"
                                        BackgroundColor="{StaticResource Cream}"
                                        Padding="8"
                                        WidthRequest="44"
                                        HeightRequest="44"
                                        StrokeThickness="0"
                                        VerticalOptions="Center">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference GardenPage}, Path=BindingContext.ToggleCompleteCommand, x:DataType={x:Null}}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding CheckMark}"
                                           FontSize="20"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center"
                                           TextColor="{StaticResource SageDeep}"
                                           InputTransparent="True" />
                                </Border>

                                <Grid Grid.Column="1"
                                      ColumnDefinitions="auto,*"
                                      ColumnSpacing="6"
                                      VerticalOptions="Center"
                                      Opacity="{Binding TitleOpacity}">
                                    <Label Text="{Binding Motif}" FontSize="16" VerticalOptions="Center" />
                                    <Label Grid.Column="1"
                                           Text="{Binding Title}"
                                           FontFamily="Nunito"
                                           FontSize="16"
                                           TextColor="{StaticResource Ink}"
                                           TextDecorations="{Binding TitleDecorations}"
                                           LineBreakMode="WordWrap"
                                           VerticalOptions="Center" />
                                </Grid>

                                <Label Grid.Column="2"
                                       Text="🍂"
                                       FontSize="16"
                                       VerticalOptions="Center"
                                       Opacity="0.7">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference GardenPage}, Path=BindingContext.DeleteTaskCommand, x:DataType={x:Null}}"
                                            CommandParameter="{Binding .}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <Label Text="küçük işler · açan çiçekler"
                       FontFamily="Caveat"
                       FontSize="18"
                       TextColor="{StaticResource InkSoft}"
                       HorizontalTextAlignment="Center"
                       Margin="0,8,0,36" />
            </CollectionView.Footer>
        </CollectionView>

        <Image Source="butterfly.png"
               WidthRequest="52"
               HeightRequest="52"
               Opacity="0.9"
               HorizontalOptions="End"
               VerticalOptions="Start"
               Margin="0,22,16,0"
               InputTransparent="True" />

        <Image Source="bee.png"
               WidthRequest="40"
               HeightRequest="40"
               Opacity="0.92"
               HorizontalOptions="Start"
               VerticalOptions="Start"
               Margin="14,78,0,0"
               InputTransparent="True"
               Rotation="-12" />

        <Image Source="ladybug.png"
               WidthRequest="32"
               HeightRequest="32"
               Opacity="0.88"
               HorizontalOptions="End"
               VerticalOptions="Start"
               Margin="0,86,58,0"
               InputTransparent="True"
               Rotation="16" />
    </Grid>
</ContentPage>
